    "codex": {
      "match": {
        "cask": [
          "codex"
        ],
        "npm": [
          "@openai/codex"
        ],
        "app": [
          "com.openai.codex"
        ]
      },
      "actions": [
        {
          "type": "cmd",
          "run": "mkdir -p ~/.codex && { grep -q '^\\[analytics\\]' ~/.codex/config.toml 2>/dev/null || printf '\\n[analytics]\\nenabled = false\\n' >> ~/.codex/config.toml; }",
          "check": "awk '/^\\[/{s=($0==\"[analytics]\")} s&&/^enabled *= *false/{f=1} END{exit !f}' ~/.codex/config.toml"
        }
      ],
      "source": "https://developers.openai.com/codex/config-reference",
      "note": "Turns off the Statsig metrics exporter in Codex core (CLI and ChatGPT.app). Ignores DO_NOT_TRACK. If an [analytics] table with enabled = true already exists, run skips and check fails — fix by hand. The Electron UI's own Segment/Datadog/Sentry have no toggle.",
      "verified": "2026-11-15"
    },
