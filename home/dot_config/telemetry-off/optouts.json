    "firefox": {
      "match": {
        "cask": [
          "firefox"
        ],
        "app": [
          "org.mozilla.firefox"
        ]
      },
      "actions": [
        {
          "type": "defaults",
          "domain": "org.mozilla.firefox",
          "key": "EnterprisePoliciesEnabled",
          "kind": "bool",
          "value": true
        },
        {
          "type": "defaults",
          "domain": "org.mozilla.firefox",
          "key": "DisableTelemetry",
          "kind": "bool",
          "value": true
        },
        {
          "type": "defaults",
          "domain": "org.mozilla.firefox",
          "key": "DisableFirefoxStudies",
          "kind": "bool",
          "value": true
        }
      ],
      "source": "https://firefox-admin-docs.mozilla.org/reference/policies/disabletelemetry/",
      "note": "User-level enterprise policies via defaults (no sudo). DisableTelemetry locks the datareporting/toolkit.telemetry upload prefs. Crash auto-submit and new-tab telemetry are separate user.js prefs.",
      "verified": "2026-11-15"
